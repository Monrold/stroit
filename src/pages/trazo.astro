---
import Layout from "../layouts/Layout.astro";
import portada from "../images/somnia.avif";
import trazologo from "../images/logotipo-trazo.svg";
---

<script
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer
></script>

<Layout title="Registro de visita" description="Regístrate para recibir información sobre nuestros productos y servicios.">
  <main class="min-h-screen bg-[#080b0f] p-4 sm:p-6 lg:p-8">
    <div class="mx-auto max-w-7xl">
      <!-- CONTENEDOR PRINCIPAL -->
      <section
        class="grid overflow-hidden rounded-2xl border border-white/10 bg-black shadow-2xl shadow-black/50 lg:grid-cols-[38%_62%]"
      >
        <!-- =========================
             IMAGEN / PORTADA
        ========================== -->

        <div
          class="relative min-h-[280px] overflow-hidden sm:min-h-[380px] lg:min-h-full"
        >
          <img
            src={portada.src}
            alt="Proyecto Cesantoni"
            class="absolute inset-0 h-full w-full object-cover"
          />

          <!-- Overlay oscuro -->
          <div class="absolute inset-0 bg-black/40"></div>

          <!-- Logo centrado -->
          <div
            class="absolute inset-0 z-10 flex items-center justify-center p-8"
          >
            <img
              src={trazologo.src}
              alt="Trazo"
              class="w-full max-w-[220px] drop-shadow-2xl sm:max-w-[180px]"
            />
          </div>
        </div>

        <!-- =========================
             FORMULARIO
        ========================== -->

        <div class="bg-black">
          <!-- HEADER -->
          <div class="border-b border-white/10 bg-black px-5 py-4 sm:px-7">
            <div class="flex items-center gap-3">
              <div>
                <h1 class="text-lg font-semibold text-white sm:text-xl">
                  Regístrate
                </h1>
              </div>
            </div>
          </div>

          <!-- =========================
               FORM
          ========================== -->

          <form
            id="formulario-visita"
            action="https://side.theparrotcrm.com/cesantoni/lead?redir=https://stroitsurfaces.com/enviado"
            method="POST"
            class="bg-black p-5 sm:p-7 lg:p-10"
          >
            <!-- NOMBRE / PERFIL -->
            <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
              <!-- Nombre -->
              <div>
                <label
                  for="nombre"
                  class="mb-2 block text-xs font-semibold uppercase tracking-wider text-slate-400"
                >
                  Nombre
                  <span class="text-amber-400">*</span>
                </label>

                <input
                  id="nombre"
                  name="nombre"
                  type="text"
                  placeholder="Ej. Carlos Mendoza"
                  required
                  autocomplete="name"
                  class="h-12 w-full rounded-xl border border-white/10 bg-[#111] px-4 text-sm text-white outline-none transition placeholder:text-slate-500 focus:border-amber-400/50 focus:ring-4 focus:ring-amber-400/10"
                />
              </div>

              <!-- Perfil -->
              <div>
                <label
                  for="perfil"
                  class="mb-2 block text-xs font-semibold uppercase tracking-wider text-slate-400"
                >
                  Perfil
                  <span class="text-amber-400">*</span>
                </label>

                <select
                  id="perfil"
                  name="perfil"
                  required
                  class="h-12 w-full rounded-xl border border-white/10 bg-[#111] px-4 text-sm text-white outline-none transition focus:border-amber-400/50 focus:ring-4 focus:ring-amber-400/10"
                >
                  <option value="" disabled selected class="bg-black">
                    Selecciona tu perfil
                  </option>

                  <option value="Arquitecto" class="bg-black">
                    Arquitecto
                  </option>

                  <option value="Estudiante" class="bg-black">
                    Estudiante
                  </option>

                  <option value="Diseñador de interiores" class="bg-black">
                    Diseñador de interiores
                  </option>

                  <option value="Profesionista" class="bg-black">
                    Profesionista
                  </option>
                </select>
              </div>
            </div>

            <!-- TELÉFONO / MATERIAL -->
            <div class="mt-5 grid grid-cols-1 gap-5 md:grid-cols-2">
              <!-- Teléfono -->
              <div>
                <label
                  for="telefono"
                  class="mb-2 block text-xs font-semibold uppercase tracking-wider text-slate-400"
                >
                  Número de teléfono
                  <span class="text-amber-400">*</span>
                </label>

                <div
                  class="flex h-12 w-full overflow-hidden rounded-xl border border-white/10 bg-[#111] transition focus-within:border-amber-400/50 focus-within:ring-4 focus-within:ring-amber-400/10"
                >
                  <!-- Código de México -->
                  <div
                    class="flex items-center border-r border-white/10 px-4 text-sm text-slate-400"
                  >
                    +52
                  </div>

                  <!-- Número -->
                  <input
                    id="telefono"
                    name="telefono"
                    type="tel"
                    inputmode="numeric"
                    autocomplete="tel"
                    placeholder="55 1234 5678"
                    maxlength="10"
                    pattern="[0-9]{10}"
                    required
                    class="h-full min-w-0 flex-1 bg-transparent px-4 text-sm text-white outline-none placeholder:text-slate-500"
                  />
                </div>
              </div>

              <!-- Material de interés -->
              <div>
                <label
                  for="material"
                  class="mb-2 block text-xs font-semibold uppercase tracking-wider text-slate-400"
                >
                  Material de interés
                  <span class="text-amber-400">*</span>
                </label>

                <select
                  id="material"
                  name="material"
                  required
                  class="h-12 w-full rounded-xl border border-white/10 bg-[#111] px-4 text-sm text-white outline-none transition focus:border-amber-400/50 focus:ring-4 focus:ring-amber-400/10"
                >
                  <option value="" disabled selected class="bg-black">
                    Selecciona un material
                  </option>

                  <option value="Sensa" class="bg-black"> Sensa </option>

                  <option value="Silestone" class="bg-black">
                    Silestone
                  </option>

                  <option value="Dekton" class="bg-black"> Dekton </option>

                  <option value="Cesantoni" class="bg-black">
                    Cesantoni
                  </option>
                </select>
              </div>
            </div>

            <!-- CORREO / ASESOR -->
            <div class="mt-5 grid grid-cols-1 gap-5 md:grid-cols-2">
              <!-- Correo -->
              <div>
                <label
                  for="correo"
                  class="mb-2 block text-xs font-semibold uppercase tracking-wider text-slate-400"
                >
                  Correo
                  <span class="text-amber-400">*</span>
                </label>

                <input
                  id="correo"
                  name="correo"
                  type="email"
                  placeholder="cliente@correo.com"
                  autocomplete="email"
                  required
                  class="h-12 w-full rounded-xl border border-white/10 bg-[#111] px-4 text-sm text-white outline-none transition placeholder:text-slate-500 focus:border-amber-400/50 focus:ring-4 focus:ring-amber-400/10"
                />
              </div>

              <!-- Asesor -->
              <div>
                <label
                  for="asesor"
                  class="mb-2 block text-xs font-semibold uppercase tracking-wider text-slate-400"
                >
                  Asesor que te atendió
                  <span class="text-amber-400">*</span>
                </label>

                <select
                  id="asesor"
                  name="asesor"
                  required
                  class="h-12 w-full rounded-xl border border-white/10 bg-[#111] px-4 text-sm text-white outline-none transition focus:border-amber-400/50 focus:ring-4 focus:ring-amber-400/10"
                >
                  <option value="" disabled selected class="bg-black">
                    Selecciona un asesor
                  </option>

                  <option value="Raquel" class="bg-black"> Raquel </option>

                  <option value="Liz" class="bg-black"> Liz </option>
                </select>
              </div>
            </div>

            <div class="mt-6">
                <div
                  class="cf-turnstile"
                  data-sitekey="0x4AAAAAAFBjYiwMlMAcXodK"
                  data-theme="dark"
                  data-size="flexible"
                  data-language="es"
                >
                </div>
              </div>

            <!-- BOTÓN -->
            <div
              class="mt-8 flex flex-col-reverse gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between"
            >
              <p class="text-xs text-slate-500">
                Los campos marcados con
                <span class="text-amber-400">*</span>
                son obligatorios.
              </p>
              

              <button
                type="submit"
                class="group flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-white px-6 text-sm font-semibold text-black transition duration-300 hover:bg-amber-400 hover:shadow-lg hover:shadow-amber-400/10 sm:w-auto"
              >
                <span>Registrar</span>

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M5 12h14"></path>
                  <path d="m13 6 6 6-6 6"></path>
                </svg>
              </button>
            </div>
          </form>
        </div>
      </section>
    </div>
  </main>
</Layout>
