import Showroom from "../../components/detalle-producto/showroom.astro";
import Ventajas from "../../components/detalle-producto/ventajas.astro";


import type { Entry } from "contentful";

export async function getStaticPaths() {
  let skip = 0;
  const limit = 100;
  let total = 0;
  let allEntries: Entry<Surfaces>[] = [];

  do {
    const response = await contentfulClient.getEntries<Surfaces>({
      content_type: "stroit",
      skip,
      limit,
    });

    allEntries = allEntries.concat(response.items);
    total = response.total;
    skip += limit;
  } while (skip < total);

  const pages = allEntries
    .map((item) => {
      const slug = item.fields.nombre && item.fields.marca
        ? `${item.fields.marca} ${item.fields.nombre}`
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .trim()
            .replace(/\s+/g, "-")
            .replace(/[^a-z0-9\-]/g, "")
        : null;

      if (!slug || slug.trim() === "") {
        console.error("Missing slug for item:", item);
        return null;
      }

      return {
        params: { slug },
        props: {
          nombre: item.fields.nombre,
          marca: item.fields.marca,
          coleccion: item.fields.coleccion,
          acabados: item.fields.acabados,
          medidas: item.fields.medidas,
          medidasSensa: item.fields.medidaSensa,
          estilo: item.fields.estilo,
          tonos: item.fields.tonos,
          espesores: item.fields.espesores,
          imagen: item.fields.imagen,
          promocion: item.fields.promocion,
          price: item.fields.price,
          pricePromo: item.fields.pricePromo,
          restriccionPromo: item.fields.restriccionPromo,
          restriccionPrecio: item.fields.restriccionPrecio,
          precio4mm: item.fields.precio4mm,
          precio8mm: item.fields.precio8Mm,
          precio12mm: item.fields.precio12Mm,
          precio20mm: item.fields.precio20Mm,
        },
      };
    })
    .filter((page) => page !== null);

  return pages;
}


const {
  nombre,
  marca,
  coleccion,
  acabados,
  medidas,
  medidasSensa,
  estilo,
  tonos,
  espesores,
  imagen,
  promocion,
  price,
  pricePromo,
  restriccionPromo,
  restriccionPrecio,
  precio4mm,
  precio8mm,
  precio12mm,
  precio20mm,
} = Astro.props;

const pageviewData = { landing: `${marca}-${nombre}` };


// --- Normalizar medidas de Contentful ---
const medidasArray: string[] = Array.isArray(medidas)
  ? medidas
  : typeof medidas === 'string'
    ? [medidas]
    : Object.values(medidas ?? {});



// --- Normalizar variable de Contentful "espesores" ---
const espesoresSeleccionados: string[] = Array.isArray(espesores)
  ? espesores
  : typeof espesores === 'string'
    ? [espesores]
    : Object.values(espesores ?? {});



const marcaLower = `${marca}`;
const hayPromo = Boolean(pricePromo);

// --- Definir tipo Espesor y variables ---
type Espesor = {
  label: string;
  precioPlaca: number;
  precioM2?: number;
  precioML?: number;
  factorML?: number;
};

let espesor: Espesor[] = [];
let areaPlaca = 1; // m²
const factorMLs: Record<string, number> = { '4 mm': 1.6, '8 mm': 1.9, '12 mm': 2.2, '20 mm': 2.6 };

// --- Función para calcular área según medidas ---
function calcularArea(medidas: string[]): number {
  if (!medidas || medidas.length === 0) return 1;

  if (medidas.length === 1) {
    const [largo, ancho] = medidas[0].replace(/cm/g, '').split('x').map(s => Number(s.trim()) / 100);
    return largo * ancho;
  }

  // Si hay varias medidas, se toma la más pequeña
  const areas = medidas.map(medida => {
    const [largo, ancho] = medida.replace(/cm/g, '').split('x').map(s => Number(s.trim()) / 100);
    return largo * ancho;
  });

  return Math.min(...areas);
}

// --- Dekton ---
if (marcaLower === 'dekton') {
  areaPlaca = calcularArea(medidasArray);
  espesor = [
    { label: '4 mm', precioPlaca: Number(precio4mm ?? 0), factorML: factorMLs['4 mm'] },
    { label: '8 mm', precioPlaca: Number(precio8mm ?? 0), factorML: factorMLs['8 mm'] },
    { label: '12 mm', precioPlaca: Number(precio12mm ?? 0), factorML: factorMLs['12 mm'] },
    { label: '20 mm', precioPlaca: Number(precio20mm ?? 0), factorML: factorMLs['20 mm'] },
  ];
}

// --- Silestone ---
else if (marcaLower === 'silestone') {
  areaPlaca = calcularArea(medidasArray);
  espesor = [
    { label: '12 mm', precioPlaca: Number(precio12mm ?? 0), factorML: factorMLs['12 mm'] },
    { label: '20 mm', precioPlaca: Number(precio20mm ?? 0), factorML: factorMLs['20 mm'] },
  ];
}

// --- Sensa / Granitops ---
else {
  let largo = 1;
  let ancho = 1;

  if (typeof medidasSensa === 'string') {
    const partes = medidasSensa.replace(/cm/g, '').split('x').map(s => s.trim());
    if (partes.length === 2) {
      largo = Number(partes[0]) / 100;
      ancho = Number(partes[1]) / 100;
    }
  }

  areaPlaca = largo * ancho;

  const precioBase = Number(pricePromo ?? price ?? 0);

  espesor = espesoresSeleccionados.includes('20 mm')
    ? [{ label: '20 mm', precioPlaca: precioBase, factorML: factorMLs['20 mm'] }]
    : [];
}

// --- Calcular precio por m² y metro lineal ---
espesor = espesor.map(e => ({
  ...e,
  precioM2: Number((e.precioPlaca / areaPlaca).toFixed(2)),
  precioML: Number(((e.precioPlaca / areaPlaca) * (e.factorML || 1)).toFixed(2))
}));

// --- Filtrar solo los espesores seleccionados (Contentful) ---
espesor = espesor.filter(e => espesoresSeleccionados.includes(e.label));

// --- Determinar medida usada en los precios ---
let medidaUsada: string = medidasArray[0] || ""; // por defecto la primera medida o string vacío

if (medidasArray.length > 1) {
  // Si hay varias medidas, se toma la que tiene el área más pequeña
  let minArea = Infinity;
  for (const medida of medidasArray) {
    const partes = medida.replace(/cm/g, '').split('x').map(s => s.trim());
    if (partes.length === 2) {
      const largo = Number(partes[0]) / 100;
      const ancho = Number(partes[1]) / 100;
      const area = largo * ancho;
      if (area < minArea) {
        minArea = area;
        medidaUsada = medida;
      }
    }
  }
}

// Para Sensa/Granitops, siempre se usa la medida específica de la placa
if (marcaLower === 'sensa' || marcaLower === 'granitops') {
  if (typeof medidasSensa === 'string') {
    medidaUsada = medidasSensa;
  }
}

console.log("Medida usada para el cálculo de precios:", medidaUsada);



