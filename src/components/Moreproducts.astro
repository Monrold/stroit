---
// Productos relacionados. Usa la misma URL que genera la ficha
// (/posts/dekton-laurent/) para que ningún enlace dé 404.
import { obtenerRelacionados } from "../lib/producto";

interface Props {
    /** Limitar a una marca: "dekton", "silestone" o "sensa". */
    marca?: string;
    /** Priorizar colores de la misma colección. */
    coleccion?: string;
    /** URL de la ficha actual, para no recomendarla a sí misma. */
    excluirUrl?: string;
    /** Fondo negro de ancho completo (blog y página de Dekton). */
    fondoNegro?: boolean;
    titulo?: string;
}

const {
    marca,
    coleccion,
    excluirUrl,
    fondoNegro = false,
    titulo = "Superficies que quizá te podrían interesar",
} = Astro.props;

const productos = await obtenerRelacionados({ marca, coleccion, excluirUrl, cantidad: 4 });
---

<style>
    .more-products-list {
        width: calc(250px * 4);
    }
</style>

{
    productos.length > 0 && (
        <section class={fondoNegro ? "bg-black" : ""}>
            <div
                class={`md:flex md:items-center md:justify-center text-white ${
                    fondoNegro ? "max-w-screen-xl mx-auto py-5" : "mx-4 pb-14 mt-5"
                }`}
            >
                <div class="md:w-1/6">
                    <h2 class="mb-6 md:mb-0 text-2xl">{titulo}</h2>
                </div>
                <div class="overflow-x-scroll snap-x snap-mandatory">
                    <ul class="more-products-list flex">
                        {productos.map((item) => (
                            <li class="mx-2">
                                <a class="text-white hover:opacity-80" href={item.url}>
                                    <img
                                        class="object-cover h-72 w-72"
                                        src={item.imagen}
                                        alt={`Textura de ${item.marcaNombre} ${item.nombre}`}
                                        loading="lazy"
                                    />
                                    <div class="mt-2">
                                        <div class="flex space-x-2">
                                            {item.promocion && <p>🔥</p>}
                                            <h3>{item.nombre}</h3>
                                        </div>
                                        <div class="flex text-[10px] md:text-xs">
                                            <p class="mr-1">{item.marcaNombre}</p>
                                            <p>|</p>
                                            <p class="ml-1">{item.coleccion}</p>
                                        </div>
                                    </div>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </section>
    )
}
