---
const { marca } = Astro.props;

const cdn = "https://cdn.stroitsurfaces.com/icons-stroit";

const ventajas = {
  fuego: { icon: "ventajas/aprueba-de-fuego.png", label: "Material a prueba de fuego" },
  color: { icon: "ventajas/durabilidad-color.png", label: "Durabilidad de color" },
  estabilidad: { icon: "ventajas/estabilidad-dimensional.png", label: "Estabilidad dimensional" },
  hidrolisis: { icon: "ventajas/hidrolisis.png", label: "Alta resistencia a la hidrólisis" },
  limpieza: { icon: "ventajas/minimo-mantenimiento.png", label: "Fácil de limpiar y mínimo mantenimiento" },
  abrasion: { icon: "ventajas/resistente-abrasion.png", label: "Resistente a la abrasión" },
  rayado: { icon: "ventajas/resistente-al-rayado.png", label: "Resistente al rayado" },
  hielo: { icon: "ventajas/resistente-hielo-deshielo.png", label: "Resistencia al hielo y deshielo" },
  manchas: { icon: "ventajas/resistente-manchas.png", label: "Resistencia a las manchas" },
  mecanica: { icon: "ventajas/resistente-mecanica.png", label: "Alta resistencia mecánica" },
  impactos: { icon: "ventajas/resistente-mecanica.png", label: "Resistencia a los impactos" },
  uv: { icon: "ventajas/resistente-rayos-uv.png", label: "Alta resistencia a los rayos UV" },
  calor: { icon: "ventajas/resistente-calor.png", label: "Resistente al fuego y al calor" },
  calorSensa: { icon: "ventajas/resistente-calor.png", label: "Resistente al calor" },
};

const aplicaciones = {
  bano: { icon: "aplicaciones/encimera-bano.png", label: "Encimeras de baño" },
  cocina: { icon: "aplicaciones/encimera-cocina.png", label: "Encimeras de cocina" },
  exterior: { icon: "aplicaciones/encimera-exterior.png", label: "Encimeras de exterior" },
  escaleras: { icon: "aplicaciones/escaleras.png", label: "Escaleras" },
  fachadas: { icon: "aplicaciones/fachadas.png", label: "Paredes y fachadas exteriores" },
  paredBano: { icon: "aplicaciones/pared-banos.png", label: "Revestimiento de pared para baños" },
  paredTerraza: { icon: "aplicaciones/revestimiento-pared.png", label: "Revestimiento de pared en terrazas" },
  sueloInterior: { icon: "aplicaciones/suelo-interior.png", label: "Suelos de interior" },
  sueloPiscina: { icon: "aplicaciones/suelo-psicinas-banos.png", label: "Suelos para baños y piscinas" },
  sueloTerraza: { icon: "aplicaciones/suelo-terrazas.png", label: "Suelos para terrazas" },
};

const porMarca = {
  dekton: {
    garantia: "25 años de garantía",
    ventajas: ["fuego", "color", "estabilidad", "hidrolisis", "limpieza", "abrasion", "rayado", "hielo", "manchas", "mecanica", "uv", "calor"],
    aplicaciones: ["cocina", "bano", "exterior", "escaleras", "fachadas", "paredBano", "paredTerraza", "sueloInterior", "sueloPiscina", "sueloTerraza"],
  },
  silestone: {
    garantia: "25 años de garantía",
    ventajas: ["rayado", "manchas", "impactos", "limpieza"],
    aplicaciones: ["cocina", "bano", "paredBano", "sueloInterior"],
  },
  sensa: {
    garantia: "15 años de garantía",
    ventajas: ["manchas", "limpieza", "rayado", "calorSensa"],
    aplicaciones: ["cocina", "bano", "paredBano", "sueloInterior"],
  },
};

const datos = porMarca[`${marca}`.toLowerCase()];

const grupos = datos
  ? [
      { titulo: "Ventajas", items: datos.ventajas.map((k) => ventajas[k]) },
      { titulo: "Aplicaciones", items: datos.aplicaciones.map((k) => aplicaciones[k]) },
    ]
  : [];
---

{datos && (
  <div class="w-full max-w-screen-xl mx-auto px-6 lg:px-10 pt-8 pb-16 lg:pb-24">
    <p class="text-xs uppercase tracking-[0.2em] text-[#dbd6ca]">
      {marca} · {datos.garantia}
    </p>

    {grupos.map((grupo) => (
      <div class="mt-12 lg:mt-16">
        <h3 class="border-b border-white/10 pb-4 text-xl md:text-2xl font-light text-white">
          {grupo.titulo}{" "}<span class="capitalize">{marca}</span>
        </h3>
        <ul
          class:list={[
            "grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-10 pt-10",
            grupo.items.length > 6 ? "lg:grid-cols-6" : "lg:grid-cols-4",
          ]}
        >
          {grupo.items.map((item) => (
            <li class="flex flex-col items-center text-center">
              <div class="h-14 w-14 flex items-center justify-center">
                <img
                  src={`${cdn}/${item.icon}`}
                  alt=""
                  loading="lazy"
                  class="max-h-full max-w-full object-contain"
                />
              </div>
              <p class="mt-4 max-w-[11rem] text-sm leading-snug text-zinc-400">
                {item.label}
              </p>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
)}
