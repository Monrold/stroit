---
// Ventajas y aplicaciones por marca (fuente: documento "Ventajas y
// aplicaciones de materiales" de Stroit). Vocabulario de México:
// cubierta (no encimera), piso (no suelo), alberca (no piscina).
import { marcaClave, marcaNombre } from "../../lib/producto";

const { marca } = Astro.props;
const clave = marcaClave(marca);
const Marca = marcaNombre(marca);

const ICONO_V = "https://cdn.stroitsurfaces.com/icons-stroit/ventajas/";
const ICONO_A = "https://cdn.stroitsurfaces.com/icons-stroit/aplicaciones/";

type Item = { texto: string; icono?: string };

const datos: Record<string, { garantia: string; ventajas: Item[]; aplicaciones: Item[] }> = {
  dekton: {
    garantia: "25 años de garantía",
    ventajas: [
      { texto: "Material a prueba de fuego", icono: "aprueba-de-fuego.png" },
      { texto: "Durabilidad del color", icono: "durabilidad-color.png" },
      { texto: "Estabilidad dimensional", icono: "estabilidad-dimensional.png" },
      { texto: "Alta resistencia a la hidrólisis", icono: "hidrolisis.png" },
      { texto: "Fácil de limpiar y mínimo mantenimiento", icono: "minimo-mantenimiento.png" },
      { texto: "Resistente a la abrasión", icono: "resistente-abrasion.png" },
      { texto: "Resistente al rayado", icono: "resistente-al-rayado.png" },
      { texto: "Resistente al hielo y deshielo", icono: "resistente-hielo-deshielo.png" },
      { texto: "Resistente a las manchas", icono: "resistente-manchas.png" },
      { texto: "Alta resistencia mecánica", icono: "resistente-mecanica.png" },
      { texto: "Alta resistencia a los rayos UV", icono: "resistente-rayos-uv.png" },
      { texto: "Resistente al fuego y al calor", icono: "resistente-calor.png" },
    ],
    aplicaciones: [
      { texto: "Cubiertas de cocina", icono: "encimera-cocina.png" },
      { texto: "Cubiertas de baño", icono: "encimera-bano.png" },
      { texto: "Cubiertas de exterior y asadores", icono: "encimera-exterior.png" },
      { texto: "Escaleras", icono: "escaleras.png" },
      { texto: "Muros y fachadas exteriores", icono: "fachadas.png" },
      { texto: "Revestimiento de muros de baño", icono: "pared-banos.png" },
      { texto: "Revestimiento de muros en terrazas", icono: "revestimiento-pared.png" },
      { texto: "Pisos de interior", icono: "suelo-interior.png" },
      { texto: "Pisos de baño y albercas", icono: "suelo-psicinas-banos.png" },
      { texto: "Pisos de terraza", icono: "suelo-terrazas.png" },
    ],
  },
  silestone: {
    garantia: "25 años de garantía",
    ventajas: [
      { texto: "Resistente al rayado", icono: "resistente-al-rayado.png" },
      { texto: "Alta resistencia a la hidrólisis", icono: "hidrolisis.png" },
      { texto: "Resistente a las manchas", icono: "resistente-manchas.png" },
      { texto: "Amplia gama de colores", icono: "durabilidad-color.png" },
      { texto: "Resistente a los impactos", icono: "resistente-mecanica.png" },
    ],
    aplicaciones: [
      { texto: "Cubiertas de cocina", icono: "encimera-cocina.png" },
      { texto: "Cubiertas de baño", icono: "encimera-bano.png" },
      { texto: "Revestimiento de muros de baño", icono: "pared-banos.png" },
      { texto: "Pisos de baño y albercas", icono: "suelo-psicinas-banos.png" },
    ],
  },
  sensa: {
    garantia: "15 años de garantía",
    ventajas: [
      { texto: "Protección antimanchas integrada", icono: "resistente-manchas.png" },
      { texto: "Bajo mantenimiento: no necesita sellado", icono: "minimo-mantenimiento.png" },
      { texto: "Piedra natural: cada placa es única", icono: "durabilidad-color.png" },
    ],
    aplicaciones: [
      { texto: "Cubiertas de cocina", icono: "encimera-cocina.png" },
      { texto: "Cubiertas de baño", icono: "encimera-bano.png" },
      { texto: "Revestimiento de muros de baño", icono: "pared-banos.png" },
    ],
  },
};

const d = datos[clave];
---

{
  d && (
    <div class="w-full max-w-7xl mx-auto pt-10 px-8 pb-6 text-white">
      <p class="text-zinc-300 mb-6">{Marca} · {d.garantia}</p>
      <div class="flex flex-col lg:flex-row gap-8">
        <div class="flex-1">
          <h3 class="text-lg font-semibold mb-4">Ventajas de {Marca}</h3>
          <ul class="grid grid-cols-3 gap-x-4 gap-y-6">
            {d.ventajas.map((v) => (
              <li class="flex flex-col items-center text-center">
                {v.icono && <img src={ICONO_V + v.icono} alt="" class="w-11 h-11 mb-1 object-contain" loading="lazy" />}
                <p class="text-xs text-zinc-400 font-medium">{v.texto}</p>
              </li>
            ))}
          </ul>
        </div>
        <div class="flex-1">
          <h3 class="text-lg font-semibold mb-4">Aplicaciones de {Marca}</h3>
          <ul class="grid grid-cols-3 gap-x-4 gap-y-6">
            {d.aplicaciones.map((a) => (
              <li class="flex flex-col items-center text-center">
                {a.icono && <img src={ICONO_A + a.icono} alt="" class="w-11 h-11 mb-1 object-contain" loading="lazy" />}
                <p class="text-xs text-zinc-400 font-medium">{a.texto}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  )
}
