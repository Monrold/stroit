---
interface Props {
	title: string;
	description: string;
	ogImage?: string;
	ogType?: string;
	lightColor?: boolean;
	pageviewData?: Record<string, any>;
	/** false = la página no aparece en Google (noindex). */
	isIndexable?: boolean;
	/** Incluye los datos del negocio y sus sucursales (Inicio y Showroom). */
	schemaNegocio?: boolean;
}

const {
	title,
	description,
	ogImage,
	ogType = "website",
	pageviewData = {},
	isIndexable = true,
	schemaNegocio = false,
}: Props = Astro.props;
import Nav from "../components/nav.astro";
import Footer from "../components/footer.astro";
import Posthog from "../components/posthog.astro";
import Google from "../components/google.astro";
import Pageview from "../components/events-meta/pageview.astro";
import { sucursales, localBusinessSchema } from "../data/sucursales";

const sitio = (Astro.site?.toString() ?? "https://stroitsurfaces.com/").replace(/\/$/, "");
// URL canónica: sin parámetros (utm, fbclid de Meta Ads) y siempre con "/" final.
const ruta = Astro.url.pathname.endsWith("/") || Astro.url.pathname.includes(".")
	? Astro.url.pathname
	: `${Astro.url.pathname}/`;
const canonical = `${sitio}${ruta}`;

const imagenOg = (() => {
	const img = ogImage ?? "https://pub-81aca52011284a96b910aedeefde00fe.r2.dev/og-image%20copia.webp";
	return img.startsWith("//") ? `https:${img}` : img;
})();

const schemaOrganizacion = schemaNegocio
	? {
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "Organization",
					"@id": `${sitio}/#organizacion`,
					name: "Stroit Surfaces",
					url: `${sitio}/`,
					logo: `${sitio}/favicon-32x32.png`,
					description:
						"Distribuidor de Cosentino en México: Dekton, Silestone y Sensa con showrooms en Pachuca y Querétaro.",
					sameAs: [
						"https://www.facebook.com/stroitsurfacescenter",
						"https://www.instagram.com/stroitsurfaces/",
						"https://www.instagram.com/stroitsurfacesbajio/",
						"https://www.tiktok.com/@stroit_surfaces",
					],
				},
				...sucursales
					.filter((s) => s.calle)
					.map((s) => ({ ...localBusinessSchema(s, sitio), parentOrganization: { "@id": `${sitio}/#organizacion` } })),
			],
		}
	: null;
---

<!doctype html>
<html lang="es-MX">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="canonical" href={canonical} />
		<meta name="robots" content={isIndexable ? "index, follow, max-image-preview:large" : "noindex, follow"} />
		<meta property="og:site_name" content="Stroit Surfaces" />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
			rel="icon"
			href="/favicon-32x32.png"
			sizes="32x32"
			type="image/png"
		/>
		<link
			rel="icon"
			href="/favicon-16x16.png"
			sizes="16x16"
			type="image/png"
		/>
		<meta property="og:image" content={imagenOg} />

		<title>{title}</title>
		{schemaOrganizacion && (
			<script type="application/ld+json" set:html={JSON.stringify(schemaOrganizacion)} />
		)}
		<slot name="head" />
		<Posthog />
		<Google />
		<Pageview eventName="PageView" customData={pageviewData} />
		<!-- Meta Pixel Code -->
		<script type="module">
			!(function (f, b, e, v, n, t, s) {
				if (f.fbq) return;
				n = f.fbq = function () {
					n.callMethod
						? n.callMethod.apply(n, arguments)
						: n.queue.push(arguments);
				};
				if (!f._fbq) f._fbq = n;
				n.push = n;
				n.loaded = !0;
				n.version = "2.0";
				n.queue = [];
				t = b.createElement(e);
				t.async = !0;
				t.src = v;
				s = b.getElementsByTagName(e)[0];
				s.parentNode.insertBefore(t, s);
			})(
				window,
				document,
				"script",
				"https://connect.facebook.net/en_US/fbevents.js",
			);
			fbq("init", "2414437608907873");
			fbq("track", "PageView");
		</script>
		<noscript
			><img
				height="1"
				width="1"
				style="display:none"
				src="https://www.facebook.com/tr?id=2414437608907873&ev=PageView&noscript=1"
			/></noscript
		>
		<!-- End Meta Pixel Code -->
	</head>
	<body class="bg-zinc-800">
		<Nav />
		<slot />
		<Footer />
	</body>
</html>
